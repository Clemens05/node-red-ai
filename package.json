{
  "name": "node-red-ai",
  "version": "0.1.0",
  "description": "A Node-RED plugin that adds a custom tab to the editor sidebar",
  "scripts": {
    "build": "npm run build:server && npm run copyfiles:html",
    "build:server": "tsc",
    "copyfiles:html": "copyfiles -u 1 \"src/server/**/*.html\" dist"
  },
  "author": {
    "name": "savvytec GmbH & Co. KG",
    "email": "info@savvytec.de",
    "url": "https://savvytec.de"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clemens05/node-red-ai.git"
  },
  "homepage": "https://github.com/clemens05/node-red-ai",
  "node-red": {
    "plugins": {
      "ai": "dist/server/main.js"
    }
  },
  "dependencies": {
    "fs-extra": "^11.2.0",
    "openai": "^4.78.1"
  },
  "devDependencies": {
    "@types/node-red": "^1.3.5",
    "copyfiles": "^2.4.1",
    "typescript": "^5.7.3"
  }
}
